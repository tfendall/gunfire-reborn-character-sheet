<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings>
    <LoaderCore Condition="'$(LoaderCore)' == ''">../../artifacts/custom-loader</LoaderCore>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Native/**" />
    <Reference Include="$(LoaderCore)/BepInEx.Core.dll" />
    <Reference Include="$(LoaderCore)/BepInEx.Preloader.Core.dll" />
    <Reference Include="$(LoaderCore)/BepInEx.Unity.IL2CPP.dll" />
    <None Include="$(LoaderCore)/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="HarmonyX" Version="2.16.1" />
  </ItemGroup>
</Project>
