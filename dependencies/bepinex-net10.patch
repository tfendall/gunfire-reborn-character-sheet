diff --git a/Runtimes/Unity/BepInEx.Unity.IL2CPP/Hook/NativeTrampoline.cs b/Runtimes/Unity/BepInEx.Unity.IL2CPP/Hook/NativeTrampoline.cs
new file mode 100644
index 0000000..1a2e443
--- /dev/null
+++ b/Runtimes/Unity/BepInEx.Unity.IL2CPP/Hook/NativeTrampoline.cs
@@ -0,0 +1,26 @@
+using System;
+using System.Linq;
+using System.Reflection;
+using System.Reflection.Emit;
+using System.Runtime.InteropServices;
+
+namespace BepInEx.Unity.IL2CPP.Hook;
+
+internal static class NativeTrampoline
+{
+    public static MethodInfo Generate(nint pointer, MethodBase signature)
+    {
+        ArgumentNullException.ThrowIfNull(signature);
+        var result = signature is MethodInfo method ? method.ReturnType : typeof(void);
+        var parameters = signature.GetParameters().Select(p => p.ParameterType).ToArray();
+        var proxy = new DynamicMethod("BepInExNativeTrampoline", result, parameters, typeof(NativeTrampoline).Module, true);
+        var il = proxy.GetILGenerator();
+        for (var index = 0; index < parameters.Length; index++) il.Emit(OpCodes.Ldarg, index);
+        il.Emit(OpCodes.Ldc_I8, (long)pointer);
+        il.Emit(OpCodes.Conv_I);
+        il.EmitCalli(OpCodes.Calli, CallingConvention.Cdecl, result, parameters);
+        il.Emit(OpCodes.Ret);
+        return proxy;
+    }
+}
+
